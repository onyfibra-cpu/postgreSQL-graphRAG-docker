# ============================================================
# GraphRAG no Umbrel (Dell R720, rede interna) — copie para .env.
#   cp .env.example .env && chmod 600 .env
# Gere segredos com: openssl rand -hex 32
# ============================================================

# IP da LAN onde as portas 9621-9623 ficam escutando.
# Use o IP do servidor na rede interna (ex.: 192.168.1.50) para não
# escutar em outras interfaces. NUNCA faça port-forward dessas portas.
LAN_BIND=0.0.0.0

# --- MiniMax (chave sk-cp da assinatura de cada empresa) -----
MINIMAX_KEY_EMPRESA1=sk-cp-...
MINIMAX_KEY_EMPRESA2=sk-cp-...
MINIMAX_KEY_EMPRESA3=sk-cp-...
LLM_MODEL=MiniMax-M3
MAX_ASYNC_LLM=2

# --- OpenAI (somente embeddings) -----------------------------
OPENAI_API_KEY=sk-...

# --- Bancos internos -----------------------------------------
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# R720 costuma ter RAM de sobra; 4g/1g é um bom ponto de partida.
NEO4J_HEAP_MAX=4g
NEO4J_PAGECACHE=1g

QDRANT_API_KEY=

POSTGRES_USER=lightrag
POSTGRES_PASSWORD=
POSTGRES_DATABASE=lightrag

# --- Autenticação por instância ------------------------------
LIGHTRAG_API_KEY_EMPRESA1=
AUTH_ACCOUNTS_EMPRESA1=admin-e1:TROQUE-ESTA-SENHA
TOKEN_SECRET_EMPRESA1=

LIGHTRAG_API_KEY_EMPRESA2=
AUTH_ACCOUNTS_EMPRESA2=admin-e2:TROQUE-ESTA-SENHA
TOKEN_SECRET_EMPRESA2=

LIGHTRAG_API_KEY_EMPRESA3=
AUTH_ACCOUNTS_EMPRESA3=admin-e3:TROQUE-ESTA-SENHA
TOKEN_SECRET_EMPRESA3=
