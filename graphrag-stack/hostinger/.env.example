# ============================================================
# GraphRAG na Hostinger — copie para .env e preencha.
#   cp .env.example .env && chmod 600 .env
# Nunca commite o .env. Gere segredos com: openssl rand -hex 32
# ============================================================

# --- Domínio e TLS -------------------------------------------
# Subdomínio da VPS Hostinger (ex.: srv123456.hstgr.cloud) ou domínio próprio
# já apontado para o IP da VPS. O Let's Encrypt emite o certificado sozinho.
PUBLIC_DOMAIN=srvXXXXXX.hstgr.cloud
ACME_EMAIL=seu-email@exemplo.com.br

# --- MiniMax (LLM: extração, imagens, respostas) -------------
# Use a "Chave de Assinatura (sk-cp)" da conta de CADA empresa
# (Console MiniMax -> Assinatura -> Detalhes do plano -> Copiar).
# Ela desconta do Token Plan; não use a chave pay-as-you-go.
MINIMAX_KEY_EMPRESA1=sk-cp-...
MINIMAX_KEY_EMPRESA2=sk-cp-...
MINIMAX_KEY_EMPRESA3=sk-cp-...

# Modelo de LLM (mesmo para as 3 instâncias).
# Alternativa mais barata/rápida para extração: o M2.7 fast — confirme o id
# exato do modelo no console da MiniMax antes de trocar.
LLM_MODEL=MiniMax-M3

# Concorrência de chamadas ao LLM. Mantenha baixa (2) para a indexação não
# disputar a cota do plano com o OpenClaw da mesma empresa.
MAX_ASYNC_LLM=2

# --- OpenAI (somente embeddings; ~US$0,02 por milhão de tokens)
OPENAI_API_KEY=sk-...

# --- Bancos internos (não expostos; senhas fortes mesmo assim)
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Ajuste à RAM da VPS: 2g de heap serve para VPS de 8 GB; suba para 4g em 16 GB.
NEO4J_HEAP_MAX=2g
NEO4J_PAGECACHE=512m

QDRANT_API_KEY=

POSTGRES_USER=lightrag
POSTGRES_PASSWORD=
POSTGRES_DATABASE=lightrag

# --- Autenticação de cada instância LightRAG -----------------
# LIGHTRAG_API_KEY_*: chave que OpenClaw/Claude/Codex mandam no header
#   X-API-Key. Uma diferente por empresa.
# AUTH_ACCOUNTS_*: login da WebUI, formato usuario:senha (aceita hash
#   {bcrypt}...). TOKEN_SECRET_*: segredo do JWT da WebUI, um por instância.
LIGHTRAG_API_KEY_EMPRESA1=
AUTH_ACCOUNTS_EMPRESA1=admin-e1:TROQUE-ESTA-SENHA
TOKEN_SECRET_EMPRESA1=

LIGHTRAG_API_KEY_EMPRESA2=
AUTH_ACCOUNTS_EMPRESA2=admin-e2:TROQUE-ESTA-SENHA
TOKEN_SECRET_EMPRESA2=

LIGHTRAG_API_KEY_EMPRESA3=
AUTH_ACCOUNTS_EMPRESA3=admin-e3:TROQUE-ESTA-SENHA
TOKEN_SECRET_EMPRESA3=
